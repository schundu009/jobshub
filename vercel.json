{
  "version": 2,
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "admin.cariara.com" }],
      "destination": "/admin-app/index.html"
    },
    {
      "source": "/:path((?!admin-app|jobs-app).*)",
      "has": [{ "type": "host", "value": "admin.cariara.com" }],
      "destination": "/admin-app/:path"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "jobs.cariara.com" }],
      "destination": "/jobs-app/discover.html"
    },
    {
      "source": "/:path((?!admin-app|jobs-app).*)",
      "has": [{ "type": "host", "value": "jobs.cariara.com" }],
      "destination": "/jobs-app/:path"
    },
    {
      "source": "/",
      "destination": "/jobs-app/discover.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    }
  ]
}
