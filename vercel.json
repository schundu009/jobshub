{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(.*)/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "admin.cariara.com"
        }
      ],
      "destination": "/admin-app/index.html"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "admin.cariara.com"
        }
      ],
      "destination": "/admin-app/:path*"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "jobs.cariara.com"
        }
      ],
      "destination": "/jobs-app/discover.html"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "jobs.cariara.com"
        }
      ],
      "destination": "/jobs-app/:path*"
    }
  ]
}
