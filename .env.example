# JobTrails Environment Configuration
# Copy this file to .env and update values as needed

# =============================================================================
# DATABASE
# =============================================================================
# PostgreSQL connection URL
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://chundu@localhost:5432/jobtrails

# Connection pool settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# =============================================================================
# REDIS
# =============================================================================
# Redis connection URL (used for caching, sessions, Celery broker)
REDIS_URL=redis://localhost:6379/0

# Cache settings
CACHE_TTL_DEFAULT=300
CACHE_TTL_ANALYTICS=300
CACHE_TTL_COMPANIES=600

# =============================================================================
# CELERY
# =============================================================================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# =============================================================================
# AUTHENTICATION (Phase 2)
# =============================================================================
# JWT secret key - CHANGE THIS IN PRODUCTION!
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-this-to-a-secure-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# SCRAPER SETTINGS
# =============================================================================
SCRAPER_DEFAULT_RATE_LIMIT=30
SCRAPER_DEFAULT_TIMEOUT=30
SCRAPER_MAX_RETRIES=3
SCRAPER_SCHEDULE_HOURS=6

# Browser pool
BROWSER_POOL_SIZE=2
BROWSER_MAX_PAGES=3
BROWSER_HEADLESS=true

# =============================================================================
# API SETTINGS
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================
OPENAI_API_KEY=

# Sentry DSN for error tracking (optional)
SENTRY_DSN=

# =============================================================================
# ENVIRONMENT
# =============================================================================
ENV=development
DEBUG=true
