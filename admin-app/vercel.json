{
  "version": 2,
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/jobs/admin",
      "destination": "/index.html"
    },
    {
      "source": "/jobs/admin/",
      "destination": "/index.html"
    },
    {
      "source": "/jobs/admin/:page([a-z_-]+)",
      "destination": "/:page.html"
    },
    {
      "source": "/jobs/admin/:path*",
      "destination": "/:path*"
    }
  ],
  "headers": [
    {
      "source": "/((?!(?:jobs/admin/)?(?:js|css|images)/).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(jobs/admin/)?js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(jobs/admin/)?css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
