FROM python:3.11-slim

WORKDIR /app

# Install Python dependencies first
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Install Playwright browsers with all dependencies
# Install both chromium and chromium-headless-shell for headless mode
RUN playwright install --with-deps chromium chromium-headless-shell

# Copy backend application code
COPY backend/ .

# Run Celery worker with all queues including browser scrapers
CMD ["celery", "-A", "celery_app", "worker", "--loglevel=info", "--concurrency=2", "-Q", "default,scrapers_http,scrapers_browser,scrapers_orchestrator,maintenance"]
