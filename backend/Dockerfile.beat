FROM python:3.11-slim

WORKDIR /app

# Install dependencies
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy backend application code
COPY backend/ .

# Create a writable directory for the schedule file
RUN mkdir -p /app/data && chmod 777 /app/data

# Run Celery beat scheduler with schedule file in writable location
CMD ["celery", "-A", "celery_app", "beat", "--loglevel=info", "-s", "/app/data/celerybeat-schedule"]
