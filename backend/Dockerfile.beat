FROM python:3.11-slim

WORKDIR /app

# Install dependencies
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy backend application code
COPY backend/ .

# Create a writable directory for the schedule file
RUN mkdir -p /app/data && chmod 777 /app/data

# Copy entrypoint script
COPY backend/beat_entrypoint.sh /app/beat_entrypoint.sh
RUN chmod +x /app/beat_entrypoint.sh

# Run beat via entrypoint (auto-restarts on crash)
CMD ["/app/beat_entrypoint.sh"]
